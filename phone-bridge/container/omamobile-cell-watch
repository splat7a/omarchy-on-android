#!/usr/bin/env python3
# SPDX-License-Identifier: MIT
"""S22 stand-in for omamobile-cell-watch (it shadows /usr/bin's from /usr/local/bin).

Android owns the modem here, so the mobile network comes from omarchy-phone, which writes the same
JSON the original reads from ModemManager ($XDG_RUNTIME_DIR/omarchy-phone/cell.json). One line per
change on stdout, as omamobile.bar expects; exits when stdout closes. With no omarchy-phone at all
(the file never appears) it hands over to the original."""
import json
import os
import sys
import time

RUNTIME = os.environ.get("XDG_RUNTIME_DIR") or f"/run/user/{os.getuid()}"
PATH = os.path.join(RUNTIME, "omarchy-phone", "cell.json")
NONE = {"modem": False, "state": "none", "strength": -1, "tech": "", "roaming": False}

if not os.path.exists("/usr/local/bin/omarchy-phone") and os.path.exists("/usr/bin/omamobile-cell-watch"):
    os.execv("/usr/bin/omamobile-cell-watch", ["omamobile-cell-watch"] + sys.argv[1:])

last, seen = None, None
while True:
    try:
        st = os.stat(PATH)
        stamp = (st.st_mtime_ns, st.st_size)
    except OSError:
        stamp = None
    if stamp != seen:
        seen = stamp
        line = None
        if stamp is None:
            line = json.dumps(NONE, separators=(",", ":"))
        else:
            try:
                with open(PATH) as f:
                    v = json.load(f)
                line = json.dumps({k: v.get(k, NONE[k]) for k in NONE}, separators=(",", ":"))
            except (OSError, ValueError):
                seen = None   # caught mid-write: read again next time
        if line is not None and line != last:
            try:
                sys.stdout.write(line + "\n")
                sys.stdout.flush()
            except (BrokenPipeError, OSError):
                sys.exit(0)
            last = line
    time.sleep(1)
